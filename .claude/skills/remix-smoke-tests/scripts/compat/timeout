#!/usr/bin/perl
# Stand-in for GNU timeout on hosts without it (macOS has no coreutils by default). The smoke scripts put this folder
# on PATH only when `timeout` is missing. Supports the subset they use: timeout [-s SIG] [-k SECS] SECS command...
# Exit status as GNU timeout: the command's own status, 124 when it timed out, 125 on a usage error.
use strict;
use warnings;

my $signal = 'TERM';
my $kill_after = 0;
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $flag = shift @ARGV;
    if ($flag eq '-s') { $signal = shift @ARGV; }
    elsif ($flag eq '-k') { $kill_after = shift @ARGV; }
    else { print STDERR "timeout: unsupported option $flag (expected -s SIG or -k SECS)\n"; exit 125; }
}
my $seconds = shift @ARGV;
if (!defined $seconds || $seconds !~ /^\d+$/ || !@ARGV) {
    print STDERR "usage: timeout [-s SIG] [-k SECS] SECS command...\n";
    exit 125;
}
$signal =~ s/^SIG//;

my $pid = fork();
die "timeout: fork failed: $!\n" unless defined $pid;
if ($pid == 0) {
    exec { $ARGV[0] } @ARGV or do { print STDERR "timeout: cannot run $ARGV[0]: $!\n"; exit 127; };
}

my $timed_out = 0;
local $SIG{ALRM} = sub {
    if (!$timed_out) {
        $timed_out = 1;
        kill $signal, $pid;
        alarm $kill_after if $kill_after > 0;
    } else {
        kill 'KILL', $pid;
    }
};
alarm $seconds;
while (waitpid($pid, 0) == -1 && $!{EINTR}) { }
alarm 0;
exit 124 if $timed_out;
exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
